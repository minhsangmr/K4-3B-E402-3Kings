# File tham khao cho API provider. Prototype tinh khong tu doc file .env;
# copy cac gia tri can dung vao tab 3. Tuyet doi khong commit file .env that.

# OpenAI - POST {BASE_URL}/chat/completions
# Request:  {model, temperature, messages:[{role, content}]}
# Response: {choices:[{message:{content}}]}
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic - POST {BASE_URL}/messages
# Request:  {model, max_tokens, temperature, system, messages:[{role, content}]}
# Response: {content:[{type:"text", text:"..."}]}
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini - POST {BASE_URL}/models/{model}:generateContent
# Request:  {system_instruction:{parts:[{text}]}, contents:[{role, parts:[{text}]}]}
# Response: {candidates:[{content:{parts:[{text}]}}]}
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (OpenAI-compatible) - POST {BASE_URL}/chat/completions
# Request/response: giong OpenAI Chat Completions; model co dang vendor/model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# 9Router (OpenAI-compatible) - local mac dinh; cloud khi tai khoan ho tro
# Local BASE_URL: http://localhost:20128/v1
# Cloud BASE_URL: https://9router.com/v1
# Request/response: giong OpenAI Chat Completions.
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=cc/claude-sonnet-5

# Custom OpenAI-compatible, vi du Ollama/LM Studio/Groq
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3.1
